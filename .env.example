# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ---- The Atlas Dispatch (news sync) ----
# Optional: GitHub personal access token for the GitHub Releases sources
GITHUB_TOKEN=
# Optional API slots (sources stay disabled until these are set)
X_BEARER_TOKEN=
IG_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
# Transactional email provider for the newsletter double opt-in
RESEND_API_KEY=
# Optional "From" override for confirmation emails (defaults to dispatch@resend.dev)
NEWSLETTER_FROM="The Atlas Dispatch <dispatch@yourdomain.com>"
# Public origin used in the confirmation link (see CONVEX_SITE_URL above)
