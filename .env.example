# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ---- Convex Auth (email OTP + anonymous) ----
# JWT keys for signing session tokens (generate with `node -e` crypto or openssl).
# Keep the full PEM including quotes. Must match the deployment's JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY=
# Matching public key (goes in BOTH .env.local for local dev and the deployment).
JWT_PUBLIC_KEY=
# JWKS derived from the public key (JSON, single line). Serves /.well-known/jwks.json.
JWKS=
# Public site origin (used for auth redirects + newsletter confirm links).
SITE_URL=http://localhost:5173

# ---- The Atlas Dispatch (news sync) ----
# Optional: GitHub personal access token for the GitHub Releases sources
GITHUB_TOKEN=
# Optional API slots (sources stay disabled until these are set)
X_BEARER_TOKEN=
IG_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
# Transactional email provider for the newsletter double opt-in
RESEND_API_KEY=
# Optional "From" override for confirmation emails (defaults to dispatch@resend.dev)
NEWSLETTER_FROM="The Atlas Dispatch <dispatch@yourdomain.com>"
# Public origin used in the confirmation link (see CONVEX_SITE_URL above)

# ---- Payments (Dodo) ----
# API key for creating checkouts (Dodo dashboard -> API keys)
DODO_PAYMENTS_API_KEY=
# Dodo product ID for the board's pay-what-you-want one-time payments
DODO_PRODUCT_ID=
# Dodo recurring product IDs — create these as subscription products in the dashboard
DODO_PREMIUM_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
# Webhook signing secret for /webhooks/dodo (Dodo dashboard -> Webhooks).
# Looks like "whsec_<base64>" — keep the prefix.
DODO_WEBHOOK_SECRET=
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

